# Server Environment Variables
# Copy this file to .env and fill in the values

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xsneviu.mongodb.net/rural_service_provider

# Secret for signing JWT tokens (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Port the server listens on (Render sets this automatically)
PORT=5000

# Comma-separated list of allowed frontend origins
# Add your Amplify URL here after deployment
CLIENT_ORIGIN=http://localhost:5173,https://main.YOUR_AMPLIFY_ID.amplifyapp.com
